# Runtime
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://your-backend.example
ALLOWED_ORIGINS=https://your-tilda-page.example
STATE_FILE=data/jobs.json

# Browser-facing prototype token. Generate a long random value.
PROTOTYPE_API_TOKEN=replace-with-random-token

# Secret shared only with the callback sender. Never put it in Tilda.
CALLBACK_SECRET=replace-with-random-secret

# Timeweb S3
S3_ENDPOINT=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=replace-with-bucket
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_PREFIX=portfolio-mvp

# Upload
MAX_FILE_BYTES=31457280
UPLOAD_URL_TTL_SECONDS=600

# Keep enabled for the first full-pipeline MVP test.
# Disable when the real analyzer starts sending callback.
MOCK_ANALYZER_ENABLED=true
MOCK_ANALYSIS_DELAY_MS=5000
MOCK_SCORE=6
